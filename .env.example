# ============================================================
# CareerPilot AI - Environment Variables Template
# Copy to .env and fill in your secrets.
# Never commit .env to version control.
# ============================================================

# ---- LLM Provider ------------------------------------------
LLM_PROVIDER=openai           # openai | google | anthropic
LLM_MODEL=gpt-4o-mini         # Model name for the selected provider
LLM_BASE_URL=                 # Optional: custom base URL (e.g. https://openrouter.ai/api/v1)

# ---- API Keys (fill the one matching LLM_PROVIDER) ---------
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# ---- Web Search (optional) ---------------------------------
WEB_SEARCH_ENABLED=true
TAVILY_API_KEY=tvly-...
SERPER_API_KEY=

# ---- Security ----------------------------------------------
API_KEY=                      # Set to a secret to require X-API-Key header (disabled when blank)
FORWARDED_ALLOW_IPS=          # IPs to trust for X-Forwarded-For (default: docker compose network)

# ---- Rate Limiting -----------------------------------------
RATE_LIMIT_PER_MINUTE=10

# ---- File Handling -----------------------------------------
MAX_PDF_SIZE_MB=10
MAX_PDF_PAGES=50
MAX_RESUME_CHARS=30000
MAX_JD_CHARS=15000

# ---- Report Saving (opt-in) --------------------------------
SAVE_REPORTS=false            # Set to true to persist reports to disk/volume
REPORT_OUTPUT_DIR=data/reports

# ---- Reliability -------------------------------------------
MAX_AGENT_RETRIES=2
AGENT_TIMEOUT_SECONDS=120

# ---- Logging -----------------------------------------------
LOG_LEVEL=INFO
DEBUG=false

# ---- Notifications (optional) ------------------------------
TELEGRAM_USER_ID=
TELEGRAM_BOT_TOKEN=
EMAIL_ADDRESS=
EMAIL_PASSWORD=