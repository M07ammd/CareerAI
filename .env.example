# ============================================================
# CareerPilot AI - Environment Variables
# Copy this to .env and fill in your API keys
# ============================================================

# ------------------------------------------------------------
# LLM Provider Configuration
# ------------------------------------------------------------
# Options: openai | google | anthropic
LLM_PROVIDER=openai

# Model name for the chosen provider
# OpenAI: gpt-4o, gpt-4o-mini, gpt-4-turbo
# Google: gemini-1.5-pro, gemini-1.5-flash
# Anthropic: claude-3-5-sonnet-20241022, claude-3-haiku-20240307
LLM_MODEL=gpt-4o-mini

# ------------------------------------------------------------
# API Keys (fill in at least one matching LLM_PROVIDER)
# ------------------------------------------------------------
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=AIza...
ANTHROPIC_API_KEY=sk-ant-...

# ------------------------------------------------------------
# Web Search (optional — enables richer roadmap and gap analysis)
# ------------------------------------------------------------
# Get Tavily key at: https://app.tavily.com
TAVILY_API_KEY=tvly-...

# Get Serper key at: https://serper.dev
# SERPER_API_KEY=...

# Disable web search entirely
WEB_SEARCH_ENABLED=true

# ------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------
APP_NAME=CareerPilot AI
VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# Max PDF upload size in MB
MAX_PDF_SIZE_MB=10

# Directory where generated reports are saved
REPORT_OUTPUT_DIR=data/reports

# ------------------------------------------------------------
# Reliability
# ------------------------------------------------------------
MAX_AGENT_RETRIES=2
AGENT_TIMEOUT_SECONDS=120

# ------------------------------------------------------------
# CORS (comma-separated list of allowed origins)
# ------------------------------------------------------------
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
