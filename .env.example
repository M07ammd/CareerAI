# ============================================================
# CareerPilot AI — Environment Variables
# Copy to .env and fill in your secrets.
# Never commit .env to version control.
# ============================================================

# ---- LLM Provider ------------------------------------------
LLM_PROVIDER=openai           # openai | google | anthropic
LLM_MODEL=gpt-4o-mini         # Model name for the selected provider
LLM_BASE_URL=                 # Optional: custom base URL (e.g. https://openrouter.ai/api/v1)

# ---- API Keys (fill the one matching LLM_PROVIDER) ---------
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# ---- Web Search (optional but recommended) -----------------
# Tavily is used first; Serper is the fallback.
WEB_SEARCH_ENABLED=true
TAVILY_API_KEY=tvly-...
SERPER_API_KEY=

# ---- Security ----------------------------------------------
# Set API_KEY to a secret string to require X-API-Key header.
# Leave blank to disable (suitable for local dev).
API_KEY=
# Comma-separated IPs / CIDR ranges to trust X-Forwarded-For from.
# Default: docker-compose internal network.
FORWARDED_ALLOW_IPS=

# ---- Rate Limiting -----------------------------------------
RATE_LIMIT_PER_MINUTE=10       # Max /analyze requests per IP per minute

# ---- File Handling -----------------------------------------
MAX_PDF_SIZE_MB=10             # Maximum PDF upload size in MB
MAX_PDF_PAGES=50               # Maximum pages extracted from PDF
MAX_RESUME_CHARS=30000         # Max chars kept from resume text before truncation
MAX_JD_CHARS=15000             # Max chars accepted in job description

# ---- Report Saving (opt-in, default off) -------------------
SAVE_REPORTS=false             # Set to true to persist JSON + Markdown reports to disk
REPORT_OUTPUT_DIR=data/reports

# ---- Reliability -------------------------------------------
MAX_AGENT_RETRIES=2            # Retry attempts after first failure (total = N+1)
AGENT_TIMEOUT_SECONDS=120      # Per-agent execution timeout

# ---- Logging -----------------------------------------------
LOG_LEVEL=INFO
DEBUG=false

# ---- CORS --------------------------------------------------
# Comma-separated list of allowed frontend origins.
# Defaults: http://localhost:5173,http://localhost:3000
# CORS_ORIGINS=https://my-app.example.com