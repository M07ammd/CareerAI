# ==============================================================================
# CareerPilot AI – Frontend Dockerfile (Multi-stage build)
# ==============================================================================

# ---- Stage 1: Build ----
FROM node:20-alpine AS build

WORKDIR /app

# Install dependencies first (leverage Docker cache)
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci || npm install

# Copy source and build
COPY frontend/ ./
# Make sure API URL is set for production (relative path to hit the proxy/ingress, or absolute if direct)
# By default, in docker-compose, frontend exposes 80, backend exposes 8000. 
# We'll rely on a basic nginx reverse proxy or direct CORS. 
# In this simple setup, Nginx will serve static files. Let's just build it.
RUN npm run build

# ---- Stage 2: Serve ----
FROM nginx:alpine

# Copy built assets from builder
COPY --from=build /app/dist /usr/share/nginx/html

# Replace default nginx config with a custom one that proxies /api to backend
RUN echo 'server { \
    listen 80; \
    location / { \
        root /usr/share/nginx/html; \
        index index.html; \
        try_files $uri $uri/ /index.html; \
    } \
    location /api/ { \
        proxy_pass http://backend:8000/api/; \
        proxy_set_header Host $host; \
        proxy_set_header X-Real-IP $remote_addr; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
