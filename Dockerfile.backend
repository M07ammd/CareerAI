# ==============================================================================
# CareerPilot AI – Backend Dockerfile
# ==============================================================================
FROM python:3.10-slim

WORKDIR /app

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

# Install system dependencies (required for PyMuPDF / some ML libs if added later)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Create necessary directories
RUN mkdir -p /app/data/reports /app/data/samples

# Copy application code
# Assuming the build context is the root directory
COPY backend/ /app/
# Copy config module to the root of /app (or it should be inside backend)
# Wait, my config.py, llm.py, etc. are currently under backend/.
# PYTHONPATH is set to /app, and backend code is copied directly into /app, so `from config import get_settings` works.

# Create non-root user
RUN adduser --disabled-password --gecos "" appuser \
    && chown -R appuser:appuser /app
USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

EXPOSE 8000

# Start Uvicorn
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
